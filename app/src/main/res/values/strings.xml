    <string name="apps_pill_waiting">Waiting</string>
    <!-- Status pill on an app row when Auto-optimize failed and will retry. -->
    <string name="apps_pill_retry">Retry</string>
    <!-- Status pill on an app row when Auto-optimize has it up to date. -->
    <string name="apps_pill_optimized">Optimized</string>
    <!-- Status pill on an app row when a newer version is available. %1$s is the version name. -->
    <string name="apps_pill_update">Update: %1$s</string>
    <!-- Status pill in the Home header when SideSpeed itself is compiled for the current build. Keep: SideSpeed -->
    <string name="home_self_optimized">SideSpeed optimized</string>
    <!-- Status pill in the Home header when SideSpeed has not yet compiled itself. Keep: SideSpeed -->
    <string name="home_self_optimizes_on_leave">SideSpeed optimizes itself when you leave</string>
    <!-- Home header status line when queued work is paused because the helper is not running. -->
    <string name="apps_maintenance_waiting_helper">Waiting for the helper</string>
    <!-- Home header status line when Auto-optimize has apps queued. %1$d is the queue length. -->
    <plurals name="apps_maintenance_waiting">
        <item quantity="one">Maintenance: %1$d waiting</item>
        <item quantity="other">Maintenance: %1$d waiting</item>
    </plurals>
    <!-- Home header status line when Auto-optimize is enabled and no apps are queued. -->
    <string name="apps_maintenance_up_to_date">Maintenance: up to date</string>
    <!-- Combines the TV address line (%1$s) and the maintenance line (%2$s) in the Home header. -->
    <string name="home_header_caption">%1$s · %2$s</string>
