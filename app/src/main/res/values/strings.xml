    <plurals name="home_sideloaded_count">
        <item quantity="one">%1$d sideloaded</item>
        <item quantity="other">%1$d sideloaded</item>
    </plurals>
    <!-- Status line on the Home My Apps tile. %1$s is the total app count, %2$s is updates or sideloaded count. -->
    <string name="home_status_my_apps">%1$s · %2$s</string>
    <!-- Detail part of the Home Auto-optimize tile status when queued work waits for the helper. -->
    <string name="home_auto_waiting_helper">waiting for the helper</string>
    <!-- Detail part of the Home Auto-optimize tile status when apps are queued. %1$d is the queue length. -->
    <plurals name="home_auto_waiting">
        <item quantity="one">%1$d waiting</item>
        <item quantity="other">%1$d waiting</item>
    </plurals>
    <!-- Detail part of the Home Auto-optimize tile status when nothing is queued. -->
    <string name="home_auto_up_to_date">up to date</string>
    <!-- Status line on the Home Auto-optimize tile. %1$s is the mode title, %2$s is the queue detail. -->
    <string name="home_status_auto_optimize">%1$s · %2$s</string>
    <!-- Status line on the Home Tools tile. -->
    <string name="home_status_tools">Space, animations, extras, home screen</string>
    <!-- Status line on the Home About tile. %1$s is the SideSpeed version name. -->
    <string name="home_status_about">Version %1$s</string>
