    <string name="apps_mode_all_title">All apps</string>
    <!-- Auto-optimize mode description for All apps. -->
    <string name="apps_mode_all_desc">Every app you installed, from a store or not, is compiled to speed and kept there after updates. Preinstalled apps are left alone unless you pick them.</string>
    <!-- Auto-optimize mode title covering only sideloaded apps. -->
    <string name="apps_mode_sideloaded_title">Sideloaded only</string>
    <!-- Auto-optimize mode description for Sideloaded only. -->
    <string name="apps_mode_sideloaded_desc">Only apps that did not come from a store are kept optimized. Apps you pick yourself are included too.</string>
    <!-- Auto-optimize mode title covering only manually selected apps. -->
    <string name="apps_mode_selected_title">Selected apps</string>
