    <string name="apps_mode_selected_desc">Only the apps you pick. Open an app and choose “Keep this app optimized” to add it.</string>
    <!-- Button label showing the active Auto-optimize mode. %1$s is the mode title. -->
    <string name="apps_auto_optimize_button">Auto-optimize: %1$s</string>
